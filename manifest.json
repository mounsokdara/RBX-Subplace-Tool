{
  "manifest_version": 3,
  "name": "Rbx Subplaces tool",
  "version": "1.0",
  "description": "Adds a Subplaces tab to Roblox games pages and a notice when you are viewing a subplace.",
  "content_scripts": [
    {
      "matches": [
        "https://roblox.com/*",
        "https://*.roblox.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.roblox.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}